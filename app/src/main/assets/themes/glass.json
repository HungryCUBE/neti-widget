{
  "schemaVersion": 1,
  "id": "glass",
  "name": "Стекло",
  "order": 10,
  "layout": "glass",
  "palette": {
    "surface": "#21FFFFFF",
    "border": "#52FFFFFF",
    "text": "#FFFFFF",
    "secondary": "#CCFFFFFF",
    "muted": "#E0FFFFFF",
    "accent": "#FFFFFF",
    "track": "#33FFFFFF",
    "pill": "#33FFFFFF",
    "pillBorder": "#40FFFFFF",
    "counter": "#D9FFFFFF"
  },
  "background": {
    "radius": 30,
    "layers": [
      {"type": "solid", "color": "#2E120C34", "when": "widget"},
      {"type": "solid", "color": "@surface"},
      {"type": "linear", "angle": 140, "opacity": 0.13, "stops": [{"color": "#38FFFFFF", "at": 0}, {"color": "#00FFFFFF", "at": 0.38}]}
    ],
    "border": {
      "width": 1,
      "color": {"type": "linear", "from": [0, 0], "to": [0, 1], "stops": [{"color": "#8CFFFFFF", "at": 0}, {"color": "@border", "at": 0.25}, {"color": "#26FFFFFF", "at": 1}]}
    }
  },
  "typography": {
    "defaults": {"font": "manrope", "textShadow": {"color": "#40000000", "blur": 2.5, "dx": 0, "dy": 0.8, "when": "widget"}},
    "header": {"size": 11, "weight": 700, "color": "@text"},
    "title": {"size": 26, "weight": 800, "letterSpacing": -0.02, "lineHeight": 1.15, "color": "@text"},
    "details": {"size": 13, "weight": 500, "color": "@secondary"},
    "next": {"size": 12, "weight": 600, "color": "@muted"},
    "counter": {"size": 12, "weight": 600, "lineHeight": 1, "tabular": true, "align": "end", "color": "@counter"}
  },
  "progress": {
    "type": "line", "height": 4, "radius": 2, "track": "@track", "fill": "@accent", "minFill": 4,
    "glow": {"color": "#B3FFFFFF", "blur": 5, "dx": 0, "dy": 0}
  },
  "strings": {
    "counterFormat": "{prefix} {minutes}"
  },
  "variants": {
    "compact": {"strings": {"counterFormat": "{minutes}"}}
  },
  "backdrop": {
    "layers": [
      {"type": "solid", "color": "#1B1450"},
      {"type": "mesh", "points": [
        {"x": 0.18, "y": 0.22, "radius": 0.42, "color": "#FF8A5C"},
        {"x": 0.82, "y": 0.78, "radius": 0.50, "color": "#4B5BFF"},
        {"x": 0.74, "y": 0.12, "radius": 0.38, "color": "#FF4F9A"},
        {"x": 0.30, "y": 0.90, "radius": 0.40, "color": "#20C4B5"}
      ]}
    ]
  }
}
