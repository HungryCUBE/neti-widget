{
  "schemaVersion": 1,
  "id": "wallpaper",
  "name": "Градиент из обоев",
  "order": 100,
  "layout": "hero",
  "tone": "@seed",
  "palette": {
    "seed": "@wallpaper.primary | @dynamic.accent1_100 | #F4E6D4",
    "base": "contrast(hsl(@seed, dh: -6.61, s: *0.9205, l: 0.698), against: #2F1A0C, min: 4.5)",
    "spotA": "hsl(@base, dh: 4.49, s: *1.5049, l: 0.8686)",
    "spotB": "hsl(@base, dh: -3.61, s: *0.882, l: 0.5843)",
    "spotC": "hsl(@base, dh: -2.14, s: *1.2856)",
    "text": "contrast(hsl(@base, dh: -3.14, s: *1.0875, l: 0.1157), against: @base, min: 4.5)",
    "secondary": "contrast(hsl(@base, dh: -1.43, s: *0.8279, l: 0.2431), against: @base, min: 4.5)",
    "muted": "contrast(hsl(@base, dh: -1.43, s: *0.8394, l: 0.2098), against: @base, min: 4.5)",
    "accent": "@text",
    "track": "#FFFFFF/42%",
    "highlight": "#FFFFFF/45%",
    "shade": "hsl(@base, dh: -1.43, s: *1.166, l: 0.2157)/22%",
    "textShadow": "transparent"
  },
  "background": {
    "radius": 28,
    "layers": [
      {"type": "solid", "color": "@base"},
      {
        "type": "radial",
        "center": [1, 0],
        "radiusOf": "farthest",
        "stops": [{"color": "@spotC", "at": 0}, {"color": "@spotC/0", "at": 0.55}]
      },
      {
        "type": "radial",
        "center": [1, 1],
        "radiusOf": "farthest",
        "stops": [{"color": "@spotB", "at": 0}, {"color": "@spotB/0", "at": 0.6}]
      },
      {
        "type": "radial",
        "center": [0, 0],
        "radiusOf": "farthest",
        "stops": [{"color": "@spotA", "at": 0}, {"color": "@spotA/0", "at": 0.55}]
      }
    ],
    "shadows": [{"dy": 1, "inset": true, "color": "@highlight"}, {"dy": 12, "blur": 28, "color": "@shade", "when": "preview"}]
  },
  "typography": {
    "defaults": {"font": "manrope", "lineHeight": 0},
    "header": {"size": 12, "weight": 600, "color": "@secondary"},
    "title": {"size": 28, "weight": 800, "letterSpacing": -0.03, "lineHeight": 1.1, "color": "@text"},
    "details": {"size": 13, "weight": 500, "color": "@secondary"},
    "next": {"size": 12, "weight": 500, "color": "@muted"},
    "nextTitle": {"base": "next", "weight": 700, "color": "@text"},
    "counter": {"size": 28, "weight": 700, "letterSpacing": -0.03, "lineHeight": 1.1, "color": "@text"},
    "unit": {"size": 12, "weight": 600, "color": "@secondary"}
  },
  "spacing": {"top": 16, "side": 18, "bottom": 14},
  "metrics": {"headerGap": 6, "counterGap": 12, "nextGap": 10},
  "progress": {"type": "line", "height": 6, "radius": 3, "track": "@track", "fill": "@accent"},
  "counter": {"type": "text", "unit": "inline", "unitGap": 3, "placement": "inline"},
  "strings": {
    "heroHeaderRight": "{until}",
    "details": "Ауд. {room}",
    "detailsNextDay": ["Ауд. {room}", "{type}"],
    "nextPrefix": "Далее · "
  },
  "backdrop": {
    "layers": [
      {"type": "linear", "angle": 160, "stops": ["#F4E6D4", "#E8CDB0"]},
      {
        "type": "radial",
        "center": [0.75, 0.15],
        "radiusOf": "farthest",
        "stops": [{"color": "#F6DCC0", "at": 0}, {"color": "#00F6DCC0", "at": 0.4}]
      },
      {
        "type": "radial",
        "center": [0.88, 0.85],
        "radiusOf": "farthest",
        "stops": [{"color": "#E9B892", "at": 0}, {"color": "#00E9B892", "at": 0.5}]
      },
      {
        "type": "radial",
        "center": [0.18, 0.12],
        "radiusOf": "farthest",
        "stops": [{"color": "#FFF8EE", "at": 0}, {"color": "#00FFF8EE", "at": 0.45}]
      }
    ]
  },
  "variants": {
    "compact": {
      "counter": {"placement": "header"},
      "typography": {"title": {"size": 19}, "counter": {"size": 18}, "unit": {"size": 10.5}}
    },
    "tone:dark": {
      "palette": {
        "base": "contrast(hsl(@seed, dh: 1.64, s: *1.055, l: 0.2137), against: #FFFFFF, min: 7)",
        "spotA": "hsl(@base, dh: -1.68, s: *1.046, l: 0.5765)",
        "spotB": "hsl(@base, dh: -2.25, s: *0.9667, l: 0.3216)",
        "spotC": "hsl(@base, dh: -1.7, s: *0.8765, l: 0.4078)",
        "text": "#FFFFFF",
        "secondary": "#FFFFFF/78%",
        "muted": "#FFFFFF/78%",
        "track": "#FFFFFF/22%",
        "highlight": "#FFFFFF/20%",
        "shade": "#000000/40%"
      },
      "background": {
        "layers": [
          {"type": "solid", "color": "@base"},
          {
            "type": "radial",
            "center": [0.2, 0.1],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotC", "at": 0}, {"color": "@spotC/0", "at": 0.5}]
          },
          {
            "type": "radial",
            "center": [0, 1],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotB", "at": 0}, {"color": "@spotB/0", "at": 0.6}]
          },
          {
            "type": "radial",
            "center": [1, 0],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotA", "at": 0}, {"color": "@spotA/0", "at": 0.6}]
          }
        ]
      },
      "backdrop": {
        "layers": [
          {"type": "linear", "angle": 180, "stops": ["#0C1122", "#070A14"]},
          {
            "type": "radial",
            "center": [0.12, 0.88],
            "radiusOf": "farthest",
            "stops": [{"color": "#1D2B55", "at": 0}, {"color": "#001D2B55", "at": 0.45}]
          },
          {
            "type": "radial",
            "center": [0.78, 0.18],
            "radiusOf": "farthest",
            "stops": [{"color": "#33478A", "at": 0}, {"color": "#0033478A", "at": 0.48}]
          }
        ]
      }
    },
    "tone:vivid": {
      "palette": {
        "base": "contrast(hsl(@seed, dh: -0.14, s: *0.6764, l: 0.498), against: #FFFFFF, min: 4.5)",
        "spotA": "hsl(@wallpaper.secondary, dh: 0.87, s: *0.7459, l: 0.5216) | hsl(@seed, s: *0.7459, l: 0.5216)",
        "spotB": "hsl(@base, dh: -1.01, s: *1.2229, l: 0.4863)",
        "spotC": "hsl(@wallpaper.tertiary, dh: -1.3, s: *0.6378, l: 0.498) | hsl(@wallpaper.secondary, s: *0.6378, l: 0.498) | hsl(@base, dh: -1.01, s: *1.2229, l: 0.498)",
        "text": "#FFFFFF",
        "secondary": "#FFFFFF/90%",
        "muted": "#FFFFFF/90%",
        "track": "#FFFFFF/28%",
        "highlight": "#FFFFFF/30%",
        "shade": "hsl(@base, dh: -8.51, s: 1, l: 0.1569)/30%",
        "textShadow": "hsl(@base, dh: -1.01, s: 1, l: 0.1569)/20%"
      },
      "background": {
        "layers": [
          {"type": "solid", "color": "@base"},
          {
            "type": "radial",
            "center": [0.5, 1.3],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotC", "at": 0}, {"color": "@spotC/0", "at": 0.7}]
          },
          {
            "type": "radial",
            "center": [1, 0.2],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotB", "at": 0}, {"color": "@spotB/0", "at": 0.6}]
          },
          {
            "type": "radial",
            "center": [0, 0],
            "radiusOf": "farthest",
            "stops": [{"color": "@spotA", "at": 0}, {"color": "@spotA/0", "at": 0.6}]
          }
        ]
      },
      "typography": {"defaults": {"shadows": [{"dy": 1, "blur": 1, "color": "@textShadow"}]}},
      "backdrop": {
        "layers": [
          {
            "type": "linear",
            "angle": 135,
            "stops": [{"color": "#FF8A5C", "at": 0}, {"color": "#E8457F", "at": 0.6}, {"color": "#9B4DFF", "at": 1}]
          },
          {
            "type": "radial",
            "center": [0.55, 1.05],
            "radiusOf": "farthest",
            "stops": [{"color": "#7A3CFF", "at": 0}, {"color": "#007A3CFF", "at": 0.6}]
          },
          {
            "type": "radial",
            "center": [0.88, 0.25],
            "radiusOf": "farthest",
            "stops": [{"color": "#FF4F8B", "at": 0}, {"color": "#00FF4F8B", "at": 0.5}]
          },
          {
            "type": "radial",
            "center": [0.12, 0.18],
            "radiusOf": "farthest",
            "stops": [{"color": "#FFBE5C", "at": 0}, {"color": "#00FFBE5C", "at": 0.45}]
          }
        ]
      }
    }
  }
}
